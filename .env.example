# ---------------------------------------------------------------------------
# Public — safe to expose. RLS is what protects the data.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth.js (Google OAuth). Server-only.
# ---------------------------------------------------------------------------
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Custom Supabase JWT (HS256). Configure the same secret in
# Supabase -> Authentication -> Third-party auth. Server-only.
# ---------------------------------------------------------------------------
SUPABASE_JWT_SECRET=
